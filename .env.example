# Postgres connection string (local Docker in dev, Vercel Marketplace Postgres in prod)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/product_announcer

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth App (for login) — see Task 4 for how to create one
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (for repo ingestion — separate from the login OAuth App in Plan 1)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Generation (AI SDK routes through the Vercel AI Gateway when this is set)
AI_GATEWAY_API_KEY=
GENERATION_MODEL=anthropic/claude-sonnet-4-5

# Cron
CRON_SECRET=

# Credential encryption (AES-256-GCM key for stored integration secrets)
# 32 bytes, hex encoded. Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=
