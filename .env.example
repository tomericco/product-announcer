# Postgres connection string (local Docker in dev, Vercel Marketplace Postgres in prod).
# This is the one to set locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/product_announcer

# Injected by the Supabase Marketplace integration on Vercel — do not set locally.
# The app reads `DATABASE_URL || POSTGRES_URL`, so this is the production fallback;
# reading it directly means rotated credentials take effect without a redeploy.
# Note `||` and not `??`: Vercel stores a valueless variable as an empty string,
# which has to fall through rather than be treated as a real URL.
# POSTGRES_URL=

# Also injected by Vercel — the DIRECT (unpooled) connection, used only by
# drizzle-kit for migrations. Supabase's pooled URL runs in transaction mode and
# does not hold a session across statements, which DDL needs. Unset locally, so
# DATABASE_URL applies during development.
# POSTGRES_URL_NON_POOLING=

# The test database. Optional: if unset, `vitest.setup.ts` derives one from
# DATABASE_URL by appending `_test` to the database name.
#
# Required either way — `npm run test` hard-fails without one, and hard-fails
# again if the resulting database name does not end in `_test`. That guard is
# load-bearing: several tests call unscoped, all-tenant functions that would
# mutate every workspace in whatever database they are pointed at, including
# real dev data.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/product_announcer_test

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth App (for login) — see Task 4 for how to create one
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth 2.0 (login) — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Invite links
# How many days a workspace invite link stays valid (default 7).
INVITE_LINK_TTL_DAYS=7

# GitHub App (for repo ingestion — separate from the login OAuth App in Plan 1)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Anthropic. REQUIRED — every AI feature fails without it: drafting, review,
# resolution, company-context analysis, signal relevance, and news selection.
#
# It appears in no `process.env` reference anywhere in the codebase because
# @ai-sdk/anthropic reads it implicitly, so grepping for it finds nothing. That
# is exactly why it is documented here.
#
# Calls go to Anthropic DIRECTLY (see src/lib/ai/model.ts), not through the
# Vercel AI Gateway. That is a deliberate cost decision — do not reintroduce a
# gateway key expecting it to be picked up; nothing reads one.
#
# Also used by the AI-visibility Claude engine, over raw fetch against the
# Messages API with the web_search tool.
ANTHROPIC_API_KEY=

# Model overrides. All optional — each falls back to a default in code. Specs may
# be gateway-style ("anthropic/claude-sonnet-4-5") or bare ("claude-sonnet-4-5");
# a leading "anthropic/" is stripped.
GENERATION_MODEL=anthropic/claude-sonnet-4-5
# ENRICHMENT_MODEL=anthropic/claude-haiku-4-5
# RESOLVER_MODEL=anthropic/claude-sonnet-4-5
# REVIEW_MODEL=anthropic/claude-sonnet-4-5
# SUMMARY_MODEL=anthropic/claude-haiku-4-5
# ONBOARDING_ANALYSIS_MODEL=anthropic/claude-sonnet-4-5
# Shared by the competitor relevance pass AND the news selection pass — there is
# no separate knob for the two, so changing this moves both.
# RELEVANCE_MODEL=anthropic/claude-haiku-4-5
# The daily brief agent. The spikes ran on Opus 5; Sonnet is the cost default.
# IDEATION_MODEL=anthropic/claude-sonnet-4-5

# The AI-visibility prompt-set generator (one call per Generate / Suggest more).
# AI_VISIBILITY_PROMPTS_MODEL=anthropic/claude-sonnet-4-5
# The batched answer judge (one call per chunk of samples in every run).
# AI_VISIBILITY_JUDGE_MODEL=anthropic/claude-sonnet-4-5

# OpenAI. Two unrelated uses:
#  1. Image generation, called DIRECTLY via @ai-sdk/openai (see
#     src/lib/ai/image-model.ts) — the one documented exception to the
#     Anthropic-only rule above, because Anthropic has no image model. Like
#     ANTHROPIC_API_KEY, the SDK reads this implicitly, so grepping finds nothing.
#  2. The AI-visibility ChatGPT engine, called over raw fetch against the
#     Responses API with the web_search tool
#     (src/lib/ai-visibility/engines/openai.ts). That one DOES read
#     process.env directly, and returns an EngineError rather than throwing
#     when the key is missing — so an unset key shows up as a failing source,
#     not a crashed run.
OPENAI_API_KEY=
# Optional; default openai/gpt-image-2. A leading "openai/" is stripped.
# IMAGE_MODEL=openai/gpt-image-2

# Vercel Blob — where generated and uploaded images live. Read implicitly by
# @vercel/blob's put()/del(). Hobby limits (1 GB, 10 GB transfer/month) are the
# binding constraint, which is why every upload is compressed first and pruned
# renders delete their blobs (src/lib/images/compress.ts, store.ts).
BLOB_READ_WRITE_TOKEN=

# Draft review loop. Optional; default 2. The draft is critiqued and, if
# non-compliant, revised and re-reviewed up to this many rounds. Any
# non-positive or unparseable value clamps to 0, which turns the loop into a
# pure gate: the draft is still reviewed, just never revised.
# REVIEW_MAX_ROUNDS=2

# Workspace signup is restricted to company email domains. Optional; a
# comma-separated allowlist of individual personal addresses that bypass that
# check. Read at call time, so changing it takes effect without a redeploy.
# ALLOWED_PERSONAL_EMAILS=you@gmail.com,cofounder@gmail.com

# Cron
CRON_SECRET=

# AI visibility (docs/superpowers/specs/2026-08-19-ai-visibility-design.md).
# Wall-clock budget for the AI-visibility step of the daily cron, in ms. Split
# across the tenants that are actually due this tick, and enforced as a deadline
# the sweep stops at. Must stay a fraction of the route's maxDuration (300s):
# brief expiry and the ideation sweep run AFTER it, so an overrun costs them.
# A malformed or non-positive value falls back to the default.
AI_VISIBILITY_SWEEP_BUDGET_MS=120000
# Engine calls in flight at once, per tenant. 12-20 finishes a 360-call run in
# one tick; four providers' rate limits are the reason this is not higher.
AI_VISIBILITY_CONCURRENCY=12

# Credential encryption (AES-256-GCM key for stored integration secrets)
# 32 bytes, hex encoded. Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# Notion public OAuth integration (developers.notion.com)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# The absolute callback URL registered on the integration, e.g.
# https://app.example.com/api/notion/callback
NOTION_OAUTH_REDIRECT_URI=
# The one-time verification_token from the webhook subscription handshake;
# used as the HMAC key to verify X-Notion-Signature.
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# LinkedIn OAuth app (for publishing to organization pages)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# The absolute callback URL registered on the LinkedIn app, e.g.
# https://app.example.com/api/linkedin/callback
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=202506
# Milliseconds between polls of an uploaded image's status before a post
# (5 polls per attempt; a still-processing image is retried by the sweep).
# LINKEDIN_IMAGE_POLL_INTERVAL_MS=1000

# Tavily Search API (for market news signals)
# Format: tvly-... (https://tavily.com)
# Free tier: 1,000 credits/month; this agent spends one credit per topic per tenant per day.
TAVILY_API_KEY=

# AI visibility (spec 2026-08-19). Four engines, all called over raw fetch —
# no provider SDKs. A missing key is not fatal: the client returns an
# EngineError, the sample is stored with status `error`, and the run reports a
# coverage gap on that engine instead of failing. So a deployment can run one,
# two or all four engines simply by which keys it sets.
#
# OPENAI_API_KEY and ANTHROPIC_API_KEY are documented above and are shared with
# the image and drafting features. These two are AI-visibility only:
# https://docs.perplexity.ai — the Agent API (POST /v1/agent). NOT Sonar chat
# completions, and not /v1/sonar: both are the old surface, retiring 2026-09-27.
PERPLEXITY_API_KEY=
# https://ai.google.dev — Gemini with google_search grounding. The first 5,000
# grounded prompts a month are free PER GOOGLE PROJECT, not per tenant.
GEMINI_API_KEY=

# Per-engine model overrides. All optional. Unlike the model specs above, these
# go straight to each provider's API verbatim — nothing is stripped or rewritten,
# because these clients do not go through the AI SDK. Use exactly the form that
# provider's catalogue lists (bare for OpenAI/Anthropic/Gemini, provider-prefixed
# for Perplexity). Changing one changes what the sparklines measure, so the run
# records the model id it actually saw and annotates the change.
# AI_VISIBILITY_OPENAI_MODEL=gpt-5.5
# Provider-PREFIXED on the Agent API; a bare "sonar" is not a valid id there.
# AI_VISIBILITY_PERPLEXITY_MODEL=perplexity/sonar
# GA rather than preview on purpose: a withdrawn preview id 404s every call,
# which reads on the dashboard exactly like an engine that stopped citing you.
# AI_VISIBILITY_GEMINI_MODEL=gemini-3.7-flash
# AI_VISIBILITY_ANTHROPIC_MODEL=claude-sonnet-5
