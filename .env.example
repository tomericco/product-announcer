# Postgres connection string (local Docker in dev, Vercel Marketplace Postgres in prod)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/product_announcer

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth App (for login) — see Task 4 for how to create one
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth 2.0 (login) — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Invite links
# How many days a workspace invite link stays valid (default 7).
INVITE_LINK_TTL_DAYS=7

# GitHub App (for repo ingestion — separate from the login OAuth App in Plan 1)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Anthropic. REQUIRED — every AI feature fails without it: drafting, review,
# resolution, company-context analysis, signal relevance, and news selection.
#
# It appears in no `process.env` reference anywhere in the codebase because
# @ai-sdk/anthropic reads it implicitly, so grepping for it finds nothing. That
# is exactly why it is documented here.
#
# Calls go to Anthropic DIRECTLY (see src/lib/ai/model.ts), not through the
# Vercel AI Gateway. That is a deliberate cost decision — do not reintroduce a
# gateway key expecting it to be picked up; nothing reads one.
ANTHROPIC_API_KEY=

# Model overrides. All optional — each falls back to a default in code. Specs may
# be gateway-style ("anthropic/claude-sonnet-4-5") or bare ("claude-sonnet-4-5");
# a leading "anthropic/" is stripped.
GENERATION_MODEL=anthropic/claude-sonnet-4-5
# ENRICHMENT_MODEL=anthropic/claude-haiku-4-5
# RESOLVER_MODEL=anthropic/claude-sonnet-4-5
# REVIEW_MODEL=anthropic/claude-sonnet-4-5
# SUMMARY_MODEL=anthropic/claude-haiku-4-5
# ONBOARDING_ANALYSIS_MODEL=anthropic/claude-sonnet-4-5
# Shared by the competitor relevance pass AND the news selection pass — there is
# no separate knob for the two, so changing this moves both.
# RELEVANCE_MODEL=anthropic/claude-haiku-4-5

# Cron
CRON_SECRET=

# Credential encryption (AES-256-GCM key for stored integration secrets)
# 32 bytes, hex encoded. Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# Notion public OAuth integration (developers.notion.com)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# The absolute callback URL registered on the integration, e.g.
# https://app.example.com/api/notion/callback
NOTION_OAUTH_REDIRECT_URI=
# The one-time verification_token from the webhook subscription handshake;
# used as the HMAC key to verify X-Notion-Signature.
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# LinkedIn OAuth app (for publishing to organization pages)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# The absolute callback URL registered on the LinkedIn app, e.g.
# https://app.example.com/api/linkedin/callback
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=202506

# Tavily Search API (for market news signals)
# Format: tvly-... (https://tavily.com)
# Free tier: 1,000 credits/month; this agent spends one credit per topic per tenant per day.
TAVILY_API_KEY=
